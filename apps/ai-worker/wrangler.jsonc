{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devpulse-ai-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-11",
  "vars": {
    "ALLOWED_ORIGIN": "http://localhost:3000"
  },
  "env": {
    "production": {
      "vars": {
        "ALLOWED_ORIGIN": "https://devpulse.example"
      }
    }
  }
}
