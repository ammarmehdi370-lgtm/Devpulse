{
  "name": "@devpulse/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "generate": "prisma generate",
    "migrate": "pnpm generate && prisma migrate deploy",
    "migrate:dev": "pnpm generate && prisma migrate dev",
    "setup": "pnpm generate && prisma migrate deploy",
    "seed": "pnpm generate && tsx prisma/seed.ts",
    "seed:reset": "pnpm generate && tsx prisma/seed.ts --reset",
    "studio": "prisma studio",
    "validate": "prisma validate",
    "db:migrate": "pnpm generate && prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "pnpm seed",
    "db:studio": "pnpm studio",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": { "@prisma/client": "^6.1.0" },
  "devDependencies": { "@devpulse/config": "workspace:*", "@types/node": "^22.10.2", "eslint": "^9.16.0", "prisma": "^6.1.0", "tsx": "^4.19.2", "tsup": "^8.3.5", "typescript": "^5.7.2", "vitest": "^2.1.8" },
  "prisma": { "seed": "tsx prisma/seed.ts" }
}
