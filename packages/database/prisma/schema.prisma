generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum ChannelType {
  PUBLIC
  PRIVATE
  DIRECT
}

enum MessageRole {
  USER
  ASSISTANT
}

enum FileOrigin {
  API
  LOCAL
  NEW
}

model User {
  id           String            @id @default(cuid())
  email        String            @unique
  name         String?
  avatarUrl    String?
  passwordHash String?
  memberships  WorkspaceMember[]
  ownedSpaces  Workspace[]       @relation("WorkspaceOwner")
  messages     Message[]
  aiConversations AIConversation[]
  aiUsage         AIUsage[]
  executions      CodeExecution[]
  editorSessions  EditorSession[]
  lastEditedFiles File[]          @relation("FileLastEditor")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Workspace {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  plan        Plan              @default(FREE)
  ownerId     String
  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  memberships WorkspaceMember[]
  projects    Project[]
  devboxes    Devbox[]
  channels    Channel[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  @@index([ownerId])
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt    DateTime      @default(now())
  @@id([workspaceId, userId])
  @@index([userId])
}

model Project {
  id            String        @id @default(cuid())
  workspaceId   String
  name          String
  defaultBranch String        @default("main")
  description   String        @default("")
  language      String        @default("TypeScript")
  stars         Int           @default(0)
  forks         Int           @default(0)
  isStarred     Boolean       @default(false)
  deployStatus  String        @default("none")
  devboxReady   Boolean       @default(true)
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  files         File[]
  aiConversations AIConversation[]
  editorSessions EditorSession[]
  devboxes      Devbox[]
  deployments   Deployment[]
  environmentVariables EnvironmentVariable[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  @@index([workspaceId])
}

model Devbox {
  id        String   @id @default(cuid())
  workspaceId String
  projectId String?
  name      String
  repo      String
  branch    String   @default("main")
  template  String
  status    String   @default("Running")
  uptime    String   @default("1m")
  vCpu      Int      @default(8)
  ram       String   @default("32 GB ECC")
  storage   String   @default("100 GB NVMe")
  port      Int      @default(3000)
  url       String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([workspaceId])
  @@index([projectId])
}

model Deployment {
  id           String   @id @default(cuid())
  projectId    String
  target       String
  domain       String
  status       String   @default("Building")
  branch       String   @default("main")
  commitHash   String
  commitMessage String
  author       String
  timestamp    String
  duration     String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([projectId])
}

model EnvironmentVariable {
  id        String   @id @default(cuid())
  projectId String
  key       String
  value     String
  scope     String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([projectId, key])
  @@index([projectId])
}

model File {
  id         String        @id @default(cuid())
  projectId  String
  path       String
  content    String        @default("")
  language   String?
  sizeBytes  Int?
  lastEditedById String?
  lastEditedBy User? @relation("FileLastEditor", fields: [lastEditedById], references: [id])
  lastEditedAt DateTime?
  version    Int           @default(1)
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisions  FileRevision[]
  executions CodeExecution[]
  aiConversations AIConversation[]
  updatedAt  DateTime      @updatedAt
  @@unique([projectId, path])
  @@index([projectId])
  @@index([projectId, path])
  @@index([projectId, updatedAt])
  @@index([projectId, language])
}

model FileRevision {
  id        String   @id @default(cuid())
  fileId    String
  version   Int
  content   String
  authorId  String?
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([fileId, version])
  @@index([fileId, createdAt])
  appliedFromAI Boolean @default(false)
  aiMessageId String?
  lineCount Int?
  charCount Int?
  diffPatch String? @db.Text
}

model Channel {
  id          String      @id @default(cuid())
  workspaceId String
  name        String
  type        ChannelType @default(PUBLIC)
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages    Message[]
  createdAt   DateTime    @default(now())
  @@index([workspaceId])
}

model Message {
  id        String   @id @default(cuid())
  channelId String
  authorId  String
  body      String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  editedAt  DateTime?
  deletedAt DateTime?
  @@index([channelId, createdAt])
}

model AIConversation {
  id            String   @id @default(cuid())
  title         String   @default("New conversation")
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  fileId        String?
  file          File?    @relation(fields: [fileId], references: [id], onDelete: SetNull)
  model         String   @default("claude-sonnet-4-6")
  messageCount  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  messages      AIMessage[]
  @@index([userId, fileId])
  @@index([projectId, updatedAt])
}

model AIMessage {
  id              String        @id @default(cuid())
  conversationId  String
  conversation    AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            MessageRole
  content         String        @db.Text
  command         String?
  tokensUsed      Int?
  responseTimeMs  Int?
  hasCode         Boolean       @default(false)
  codeLanguage    String?
  appliedToFileId String?
  appliedAt       DateTime?
  createdAt       DateTime      @default(now())
  @@index([conversationId, createdAt])
}

model AIUsage {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId   String?
  month         Int
  year          Int
  requestCount  Int      @default(0)
  tokenCount    Int      @default(0)
  estimatedCost Float    @default(0)
  updatedAt     DateTime @updatedAt
  @@unique([userId, month, year])
  @@index([userId, year, month])
}

model CodeExecution {
  id         String   @id @default(cuid())
  fileId     String
  file       File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  language   String
  code       String   @db.Text
  stdout     String?  @db.Text
  stderr     String?  @db.Text
  exitCode   Int?
  durationMs Int?
  timedOut   Boolean  @default(false)
  createdAt  DateTime @default(now())
  @@index([fileId, createdAt])
  @@index([userId, createdAt])
}

model EditorSession {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  openFileIds     String[]
  activeFileId    String?
  scrollPositions Json?
  cursorPositions Json?
  updatedAt       DateTime @updatedAt
  @@unique([userId, projectId])
  @@index([userId, updatedAt])
}
