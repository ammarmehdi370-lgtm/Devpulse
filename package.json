{
  "name": "devpulse",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=20.10.0" },
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "dev:turbo": "turbo dev",
    "build": "npm --prefix apps/web run build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "pnpm --filter @devpulse/database db:migrate",
    "seed": "pnpm --filter @devpulse/database db:seed",
    "studio": "pnpm --filter @devpulse/database db:studio",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "@devpulse/config": "workspace:*",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
