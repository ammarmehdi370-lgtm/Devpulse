{
  "name": "devpulse",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "projects/code-editor/frontend",
    "projects/code-editor/backend"
  ],
  "scripts": {
    "dev:editor": "npm run dev --workspace=projects/code-editor/frontend & npm run dev --workspace=projects/code-editor/backend",
    "dev:frontend": "npm run dev --workspace=projects/code-editor/frontend",
    "dev:backend": "npm run dev --workspace=projects/code-editor/backend",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
