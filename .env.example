# ============================================
# Devpulse Environment Configuration
# Copy this file to .env (or run the setup script).
# Never commit .env or production credentials.
# ============================================

# --- Environment and application URLs ---
NODE_ENV=development
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000
SOCKET_URL=http://localhost:4001
AI_URL=http://localhost:4002

# --- PostgreSQL ---
# Host applications connect through localhost:5433.
# Docker Compose containers connect through postgres:5432.
DATABASE_URL=postgresql://devpulse:devpulse@localhost:5433/devpulse?schema=public
DIRECT_DATABASE_URL=postgresql://devpulse:devpulse@localhost:5433/devpulse?schema=public
POSTGRES_USER=devpulse
POSTGRES_PASSWORD=devpulse
POSTGRES_DB=devpulse
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- MinIO object storage ---
# For host processes use localhost; Compose overrides the API endpoint to minio.
MINIO_ENDPOINT=http://localhost:9000
MINIO_PORT=9000
MINIO_ACCESS_KEY=devpulse
MINIO_SECRET_KEY=devpulse123
MINIO_BUCKET=devpulse-files
MINIO_USE_SSL=false
MINIO_CONSOLE_PORT=9001
# Legacy/AWS-compatible aliases used by existing storage integrations.
S3_MINIO_ROOT_USER=devpulse
S3_MINIO_ROOT_PASSWORD=devpulse123
AWS_ACCESS_KEY_ID=devpulse
AWS_SECRET_ACCESS_KEY=devpulse123
AWS_REGION=us-east-1
AWS_S3_BUCKET=devpulse-files
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_FORCE_PATH_STYLE=true

# --- JWT authentication ---
# RS256 keys are generated by scripts/setup-env.sh or scripts/setup-env.ps1.
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
# Legacy symmetric settings are retained for compatibility with existing routes.
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-second-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- OAuth session ---
# Setup scripts replace this placeholder with 32 random bytes (hex encoded).
SESSION_SECRET=replace-with-openssl-rand-hex-32-output

# --- OAuth providers (optional for local development) ---
# Keep all OAuth credentials server-side; never use NEXT_PUBLIC_* variables.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
SAML_ENTRYPOINT=

# --- Email (Resend, optional for local development) ---
RESEND_API_KEY=
EMAIL_FROM=noreply@resend.dev
EMAIL_FROM_NAME=Devpulse

# --- AI (Anthropic, optional for local development) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Billing (optional) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# --- Service ports ---
PORT=4000
SOCKET_PORT=4001
AI_PORT=4002

# --- Browser/mobile client URLs ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4001
NEXT_PUBLIC_AI_URL=http://localhost:4002
NEXT_PUBLIC_APP_URL=http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_SOCKET_URL=http://localhost:4001

# --- Test-only cleanup endpoint ---
TEST_CLEANUP_SECRET=e2e-cleanup-secret
