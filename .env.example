NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
SOCKET_URL=http://localhost:4001
AI_URL=http://localhost:4002
# Host tools use localhost:5433; containers reach Postgres at postgres:5432.
DATABASE_URL=postgresql://devpulse:devpulse@localhost:5433/devpulse?schema=public
DIRECT_DATABASE_URL=postgresql://devpulse:devpulse@localhost:5433/devpulse?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-second-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
# Required for OAuth state sessions; must be at least 32 characters.
# Generate with: openssl rand -hex 32
SESSION_SECRET=
FRONTEND_URL=http://localhost:3000
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
# Docker Compose local MinIO credentials default to these local-only values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=devpulse-local
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_FORCE_PATH_STYLE=true
# OAuth credentials are server-side only. Use separate OAuth apps/clients for
# local development and production; never expose these as NEXT_PUBLIC_* vars.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Local redirect URI: http://localhost:4000/api/auth/github/callback
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
SAML_ENTRYPOINT=
# Resend API key is optional; magic-link requests return a clear 503 in
# production until a sending key is configured. Create one at https://resend.com
RESEND_API_KEY=
# Development: Resend's test sender works without domain verification.
# Production: use noreply@devpulse.io after verifying devpulse.io in Resend
# and publishing the SPF/DKIM DNS records Resend provides.
EMAIL_FROM=noreply@resend.dev
EMAIL_FROM_NAME=Devpulse
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4001
NEXT_PUBLIC_AI_URL=http://localhost:4002
NEXT_PUBLIC_APP_URL=http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_SOCKET_URL=http://localhost:4001
# Docker Compose local infrastructure defaults.
S3_MINIO_ROOT_USER=devpulse
S3_MINIO_ROOT_PASSWORD=devpulse-local-password
POSTGRES_USER=devpulse
POSTGRES_PASSWORD=devpulse
POSTGRES_DB=devpulse
