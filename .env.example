DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD_URL_ENCODED@localhost:5432/devpulse
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173

# Optional SMTP settings. Without these, verification links are logged by the backend for local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DevPulse <no-reply@example.com>

# Claude AI
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Required for workspace-scoped Anthropic API keys.
ANTHROPIC_WORKSPACE_ID=
